{
    "name": "admin",
    "version": "0.0.17",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.3.0",
        "node": ">=26"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve --proxy-config proxy.conf.json --define \"APP_VERSION='$npm_package_version'\"",
        "build": "ng build --define \"APP_VERSION='$npm_package_version'\" && bun run build:server",
        "build:server": "bun build server.ts --target=node --outfile dist/admin/server/server.mjs",
        "watch": "ng build --watch --configuration development --define \"APP_VERSION='$npm_package_version'\"",
        "serve:admin": "ADMIN_API_ORIGIN=${ADMIN_API_ORIGIN:-http://localhost:20001} node dist/admin/server/server.mjs",
        "test": "ng test"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^22.2.1",
        "@angular/compiler": "^22.2.1",
        "@angular/core": "^22.2.1",
        "@angular/forms": "^22.2.1",
        "@angular/platform-browser": "^22.2.1",
        "@angular/router": "^22.2.1",
        "compression": "^1.8.2",
        "express": "^5.2.1",
        "http-proxy-middleware": "^4.2.0",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^22.2.2",
        "@angular/cli": "^22.2.2",
        "@angular/compiler-cli": "^22.2.1",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.4",
        "jsdom": "^30.1.2",
        "prettier": "^3.9.9",
        "typescript": "~6.0.3",
        "vitest": "^5.0.3"
    }
}
