{
    "name": "admin",
    "version": "0.0.16",
    "packageManager": "bun@1.3.14",
    "engines": {
        "bun": ">=1.3.0",
        "node": ">=26"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve --proxy-config proxy.conf.json --define \"APP_VERSION='$npm_package_version'\"",
        "build": "ng build --define \"APP_VERSION='$npm_package_version'\" && bun run build:server",
        "build:server": "bun build server.ts --target=node --outfile dist/admin/server/server.mjs",
        "watch": "ng build --watch --configuration development --define \"APP_VERSION='$npm_package_version'\"",
        "serve:admin": "node dist/admin/server/server.mjs",
        "test": "ng test"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^22.1.2",
        "@angular/compiler": "^22.1.2",
        "@angular/core": "^22.1.2",
        "@angular/forms": "^22.1.2",
        "@angular/platform-browser": "^22.1.2",
        "@angular/router": "^22.1.2",
        "compression": "^1.8.1",
        "express": "^5.2.1",
        "http-proxy-middleware": "^4.2.0",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^22.1.4",
        "@angular/cli": "^22.1.4",
        "@angular/compiler-cli": "^22.1.2",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "typescript": "~6.0.3",
        "vitest": "^4.1.10"
    }
}
